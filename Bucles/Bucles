total_goles = 0

while True:
    entrada = input("Ingresá la cantidad de goles (o escribí 'ya terminó'): ")

    if entrada.lower() == "ya terminó":
        break

    goles = int(entrada)
    total_goles += goles

print("Total de goles:", total_goles)


